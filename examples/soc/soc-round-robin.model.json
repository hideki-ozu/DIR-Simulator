{
  "schema_version": 1,
  "profile": "soc.shared.v1",
  "clock_period": "10ps",
  "bus": "Main.bus",
  "targets": [
    {
      "node": "Main.t",
      "base": 0,
      "size": 32,
      "error_ranges": [
        {
          "start": 16,
          "end": 20
        }
      ],
      "service_cycles": 1
    }
  ],
  "sources": [
    {
      "node": "Main.m0",
      "capacity": 2,
      "priority": 0
    },
    {
      "node": "Main.m1",
      "capacity": 2,
      "priority": 1
    }
  ],
  "arbitration": "round_robin",
  "bytes_per_cycle": 4
}
