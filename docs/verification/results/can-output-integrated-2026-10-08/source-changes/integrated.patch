+            let encoded = EncodedRow::new(&key, i, &value).unwrap();
+            last_payload_offset = offset + 8 + FRAME_FIELDS as u64 + encoded.key.len() as u64;
+            offset += 8 + encoded.frame_len().unwrap() as u64;
