+// order; concatenated terminated components also preserve Vec prefix order.
+fn encode_key(key: &[String]) -> Result<Vec<u8>, Diagnostic> {
+    let mut encoded = Vec::new();
+    let capacity = key.iter().try_fold(0usize, |size, part| {
+        part.len()
