+    #[test]
+    fn unknown_archived_statistics_target_is_a_diagnostic() {
+        let output = directory();
+        let prepared = prepared();
+        let snapshot =
+            crate::runtime::spool::with_spooling(&output, || crate::runtime::simulate(&prepared))
+                .unwrap();
+        let archive = fs::read_dir(&output)
+            .unwrap()
+            .map(|e| e.unwrap().path())
+            .find(|p| {
+                p.file_name()
+                    .unwrap()
+                    .to_string_lossy()
+                    .starts_with(".dir-can-ledger-")
+            })
+            .unwrap();
+        let text = fs::read_to_string(&archive).unwrap();
+        let mut lines = text.lines();
+        let mut first: serde_json::Value = serde_json::from_str(lines.next().unwrap()).unwrap();
+        first["request"]["source"] = json!("unknown-topology-node");
+        let mut altered = serde_json::to_string(&first).unwrap();
+        altered.push('\n');
+        for line in lines {
+            altered.push_str(line);
+            altered.push('\n');
+        }
+        fs::write(&archive, altered).unwrap();
+        let error = super::super::export(&prepared, &snapshot, &output).unwrap_err();
+        assert_eq!(error.code, "E-0003");
+        assert!(!output.join("manifest.json").exists());
+        assert!(!fs::read_dir(&output).unwrap().any(|e| {
+            let name = e.unwrap().file_name();
+            let name = name.to_string_lossy();
+            name.starts_with(".dir-result-sort-")
+                || name.starts_with(".dir-contribution-sort-")
+                || name.starts_with(".dir-result-ordered-")
+        }));
+        drop(snapshot);
+        fs::remove_dir_all(output).unwrap();
+    }
+    #[test]
+    fn multibus_stats_slots_and_reopened_pair_match_materialized_output() {
+        use super::super::csv;
+        let output = directory();
+        let config =
+            PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../examples/gateway/fanout.ini");
+        let prepared = crate::prepare(&config).unwrap();
+        assert_ne!(prepared.can.buses.len(), prepared.can.controllers.len());
+        let topology = Topology::new(&prepared).unwrap();
+        let stats = StatsTable::new(&prepared).unwrap();
+        let controller = &prepared.can.controllers[0].id;
+        assert_ne!(
+            topology.id(controller).unwrap() as usize,
+            stats.slot(controller).unwrap()
+        );
+        // Predeclared targets retain zero counts before their first update.
+        for value in &stats.values {
+            assert_eq!(value.requests, 0);
+            assert_eq!(value.rx, 0);
+            assert_eq!(value.delays, [(0, 0); 4]);
+        }
+        let memory = crate::runtime::simulate(&prepared).unwrap();
+        let archived =
+            crate::runtime::spool::with_spooling(&output, || crate::runtime::simulate(&prepared))
+                .unwrap();
+        let result = super::prepare(&prepared, &archived, &output).unwrap();
+        let (records, summary) = aggregate::records(&prepared, &memory).unwrap();
+        let mut expected_json = Vec::new();
+        json::write_result(
+            &mut expected_json,
+            &prepared,
+            &memory,
+            "combined",
+            "2026-10-08T00:00:00Z",
+            &records,
+            &summary,
+        )
+        .unwrap();
+        let expected_json: serde_json::Value = serde_json::from_slice(&expected_json).unwrap();
+        let mut expected_csv = Vec::new();
+        csv::write(&mut expected_csv, &records, "combined", 2).unwrap();
+        for _ in 0..2 {
+            let mut actual_json = Vec::new();
+            let mut actual_csv = Vec::new();
+            json::write_stream_result(
+                &mut actual_json,
+                &mut actual_csv,
+                &prepared,
+                &archived,
+                "combined",
+                "2026-10-08T00:00:00Z",
+                &result,
+            )
+            .unwrap();
+            let actual_json: serde_json::Value = serde_json::from_slice(&actual_json).unwrap();
+            assert_eq!(actual_json["simulation"], expected_json["simulation"]);
+            assert_eq!(actual_csv, expected_csv);
+        }
+        drop(result);
+        drop(archived);
+        assert_eq!(fs::read_dir(&output).unwrap().count(), 0);
+        fs::remove_dir(output).unwrap();
+    }
