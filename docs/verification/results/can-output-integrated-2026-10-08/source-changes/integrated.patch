+                Ok(()) => {
+                    let path = directory.join("rows");
+                    let file = OpenOptions::new()
+                        .create_new(true)
+                        .write(true)
+                        .open(&path)
+                        .map_err(|e| error("create", e));
+                    return match file {
+                        Ok(file) => {
+                            let mut result = Self {
+                                directory,
+                                path,
+                                writer: Some(BufWriter::with_capacity(1024 * 1024, file)),
+                                previous: None,
+                                disordered: false,
+                                next: 0,
+                                max_frame_bytes: 0,
