  n23.tx --> canmillion.Wire --> bus.rx_n23;
  bus.tx_n23 --> canmillion.Wire --> n23.rx;
  n24.tx --> canmillion.Wire --> bus.rx_n24;
  bus.tx_n24 --> canmillion.Wire --> n24.rx;
  n25.tx --> canmillion.Wire --> bus.rx_n25;
  bus.tx_n25 --> canmillion.Wire --> n25.rx;
  n26.tx --> canmillion.Wire --> bus.rx_n26;
  bus.tx_n26 --> canmillion.Wire --> n26.rx;
  n27.tx --> canmillion.Wire --> bus.rx_n27;
  bus.tx_n27 --> canmillion.Wire --> n27.rx;
