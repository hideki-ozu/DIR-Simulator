package canmillion;
simple Controller {
 parameters:
  @class("dir.can.Controller");
  int queueCapacity = default(64);
  double txProcessingDelay @unit(s) = default(0ps);
  double rxProcessingDelay @unit(s) = default(0ps);
  string rxFilter = default("*");
 gates: output tx; input rx;
}
simple Bus {
 parameters:
  @class("dir.can.Bus");
  double bitrate @unit(bps);
  string profile = default("can.cc.ideal.v1");
 gates:
  input rx_n00;
  output tx_n00;
  input rx_n01;
  output tx_n01;
  input rx_n02;
  output tx_n02;
  input rx_n03;
  output tx_n03;
  input rx_n04;
  output tx_n04;
  input rx_n05;
  output tx_n05;
  input rx_n06;
  output tx_n06;
  input rx_n07;
  output tx_n07;
  input rx_n08;
  output tx_n08;
  input rx_n09;
  output tx_n09;
  input rx_n10;
  output tx_n10;
  input rx_n11;
  output tx_n11;
  input rx_n12;
  output tx_n12;
  input rx_n13;
  output tx_n13;
  input rx_n14;
  output tx_n14;
  input rx_n15;
  output tx_n15;
  input rx_n16;
  output tx_n16;
  input rx_n17;
  output tx_n17;
  input rx_n18;
  output tx_n18;
  input rx_n19;
  output tx_n19;
  input rx_n20;
  output tx_n20;
  input rx_n21;
  output tx_n21;
  input rx_n22;
  output tx_n22;
  input rx_n23;
  output tx_n23;
  input rx_n24;
  output tx_n24;
  input rx_n25;
  output tx_n25;
  input rx_n26;
  output tx_n26;
  input rx_n27;
  output tx_n27;
  input rx_n28;
  output tx_n28;
  input rx_n29;
  output tx_n29;
  input rx_n30;
  output tx_n30;
  input rx_n31;
  output tx_n31;
}
channel Wire {
 parameters:
  @class("dir.link.FixedDelay");
  double delay @unit(s) = default(0ps);
}
network Main {
 submodules:
  n00: canmillion.Controller;
  n01: canmillion.Controller;
  n02: canmillion.Controller;
  n03: canmillion.Controller;
  n04: canmillion.Controller;
  n05: canmillion.Controller;
  n06: canmillion.Controller;
  n07: canmillion.Controller;
  n08: canmillion.Controller;
  n09: canmillion.Controller;
  n10: canmillion.Controller;
  n11: canmillion.Controller;
  n12: canmillion.Controller;
  n13: canmillion.Controller;
  n14: canmillion.Controller;
  n15: canmillion.Controller;
  n16: canmillion.Controller;
  n17: canmillion.Controller;
  n18: canmillion.Controller;
  n19: canmillion.Controller;
  n20: canmillion.Controller;
  n21: canmillion.Controller;
  n22: canmillion.Controller;
  n23: canmillion.Controller;
  n24: canmillion.Controller;
  n25: canmillion.Controller;
  n26: canmillion.Controller;
  n27: canmillion.Controller;
  n28: canmillion.Controller;
  n29: canmillion.Controller;
  n30: canmillion.Controller;
  n31: canmillion.Controller;
  bus: canmillion.Bus;
 connections:
  n00.tx --> canmillion.Wire --> bus.rx_n00;
  bus.tx_n00 --> canmillion.Wire --> n00.rx;
  n01.tx --> canmillion.Wire --> bus.rx_n01;
  bus.tx_n01 --> canmillion.Wire --> n01.rx;
  n02.tx --> canmillion.Wire --> bus.rx_n02;
  bus.tx_n02 --> canmillion.Wire --> n02.rx;
