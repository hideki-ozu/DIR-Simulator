  bus.tx_n14 --> canmillion.Wire --> n14.rx;
  n15.tx --> canmillion.Wire --> bus.rx_n15;
  bus.tx_n15 --> canmillion.Wire --> n15.rx;
  n16.tx --> canmillion.Wire --> bus.rx_n16;
  bus.tx_n16 --> canmillion.Wire --> n16.rx;
  n17.tx --> canmillion.Wire --> bus.rx_n17;
  bus.tx_n17 --> canmillion.Wire --> n17.rx;
  n18.tx --> canmillion.Wire --> bus.rx_n18;
  bus.tx_n18 --> canmillion.Wire --> n18.rx;
  n19.tx --> canmillion.Wire --> bus.rx_n19;
  bus.tx_n19 --> canmillion.Wire --> n19.rx;
  n20.tx --> canmillion.Wire --> bus.rx_n20;
