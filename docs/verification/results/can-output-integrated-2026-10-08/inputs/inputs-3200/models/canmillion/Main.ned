  bus.tx_n06 --> canmillion.Wire --> n06.rx;
  n07.tx --> canmillion.Wire --> bus.rx_n07;
  bus.tx_n07 --> canmillion.Wire --> n07.rx;
  n08.tx --> canmillion.Wire --> bus.rx_n08;
  bus.tx_n08 --> canmillion.Wire --> n08.rx;
  n09.tx --> canmillion.Wire --> bus.rx_n09;
