+        for time in [0, 1, u64::MAX] {
+            for target in ["A", "a"] {
+                for metric in ["buffer_utilization", "queue_length"] {
+                    for reason in [None, Some("x")] {
+                        for receiver in [None, Some("R")] {
+                            let mut row =
+                                Record::aggregate(target, metric, MetricValue::Integer(0), 0, time);
+                            row.reason = reason.map(str::to_owned);
+                            row.receiver = receiver.map(str::to_owned);
+                            rows.push(row.clone());
+                            row.time_ps = Some(time);
+                            row.end_ps = None;
+                            rows.push(row);
+                        }
+                    }
+                }
+            }
