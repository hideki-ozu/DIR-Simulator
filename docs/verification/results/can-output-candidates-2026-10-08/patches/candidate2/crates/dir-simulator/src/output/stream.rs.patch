+            let keys: Vec<_> = stream
+                .records
+                .iter()
+                .unwrap()
+                .map(|row| row.unwrap().key)
+                .collect();
+            assert!(keys.windows(2).all(|pair| pair[0] <= pair[1]));
+            drop(stream);
+            drop(snapshot);
+            fs::remove_dir_all(output).unwrap();
+        }
