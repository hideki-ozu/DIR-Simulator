          },
          {
            "id": "b:0@Main.sw.tx_a",
            "sof_ps": "579000",
            "eof_ps": "1155000"
          }
        ]
      }
    },
    {
      "name": "broadcast",
      "config": "broadcast.ini",
      "workload": "broadcast.json",
      "model_config": "model.json",
      "expected": {
        "generated": 1,
        "offered": 3,
        "serialized": 3,
        "dropped": 0,
        "received": 2,
        "filtered": 0,
        "delivery_ps": "1156000"
