        "transfer_times": [
          {
            "id": "a:0@Main.a.tx",
            "sof_ps": "0",
            "eof_ps": "576000",
            "release_ps": "672000",
            "arrival_ps": "577000"
          },
          {
            "id": "a:0@Main.sw.tx_b",
            "sof_ps": "579000",
            "eof_ps": "1155000",
            "release_ps": "1251000",
            "arrival_ps": "1156000"
          }
        ]
      }
    },
    {
      "name": "duplex",
      "config": "duplex.ini",
      "workload": "duplex.json",
      "model_config": "model.json",
      "expected": {
        "generated": 2,
