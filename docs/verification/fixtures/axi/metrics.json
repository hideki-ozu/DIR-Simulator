{
  "schema_version": 1,
  "profile": "axi4.transaction.v1",
  "metrics": [
    {
      "metric_id": "axi.active",
      "version": "1",
      "unit": "count",
      "value_kind": "integer",
      "sampling": "summary",
      "aggregation": "sum"
    },
    {
