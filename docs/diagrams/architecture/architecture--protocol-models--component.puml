@startuml architecture--protocol-models--component
' Document: ../../アーキテクチャ設計書.md
' Section: 全対象モデルと拡張境界
' Purpose: プロトコルcrateと構成要素（設計案）

skinparam backgroundColor white
skinparam defaultFontName Noto Sans CJK JP
skinparam defaultFontSize 14
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #475569
skinparam LineColor #475569
skinparam componentStyle rectangle
skinparam componentBackgroundColor #EFF6FF
skinparam componentBorderColor #64748B
skinparam activityBackgroundColor #EFF6FF
skinparam activityBorderColor #64748B
skinparam activityDiamondBackgroundColor #FFF7ED
skinparam noteBackgroundColor #FFFBEA
skinparam noteBorderColor #D6C77A
skinparam classBackgroundColor #EFF6FF
skinparam classBorderColor #64748B
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #94A3B8

title プロトコルcrateと構成要素（設計案）

top to bottom direction
package "共通実行" {
 component "ProfileRegistry / PreparedProfile" as registry
 component "Engine / EffectBatch / journal" as engine
 registry --> engine
}
package "sim-can" {
 component "Controller / BusContext\nCRC / stuffing / arbitration" as can
}
package "sim-gw" {
 component "Routing coordinator\n独立CANバス / コピー追跡" as gw
}
package "sim-axi" {
 component "Manager / Interconnect / Ram\n5チャネル / round-robin" as axi
}
package "sim-ethernet" {
 component "Endpoint / Switch / Link\n全二重 / FDB / 出力FIFO\nCSMA/CD共有媒体 / 100・1000BASE-T1" as ethernet
}
package "追加モデル" {
 component "CAN FD\n証跡付き位相別bit数" as fd
 component "SoC共有バス / AHB / NoC\nFIFO / 仲裁 / XY経路" as soc
 component "DDR / SRAM / IPC / DMA\nbyte内容 / 所有権 / 通知" as memory
}
fd --> registry : FD profile
soc --> registry : transaction profiles
memory --> registry : memory-ipc profile
can --> registry : 既定profile + 固定Multibus型
can --> engine : 汎用イベント・計測
 gw --> can : CAN状態機械の再利用
 gw --> registry : multibus profile
 axi --> registry : transaction profile
 ethernet --> registry : L2 profile
legend bottom
  全構成は設計段階。製品実装・実行試験は未実施。
  0.1.0は単一CAN、1.0.0はGW、残る追加モデルは1.0.0以後の計画。
  各モデルの詳細仕様・設計・検証が外部契約と処理を規定する。
endlegend
@enduml
