@startuml architecture--protocol-models--component
' Document: ../../アーキテクチャ設計書.md
' Section: Protocol Crates
' Purpose: プロトコルcrateと構成要素（設計案）

skinparam backgroundColor white
skinparam defaultFontName Noto Sans CJK JP
skinparam defaultFontSize 14
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #475569
skinparam LineColor #475569
skinparam componentStyle rectangle
skinparam componentBackgroundColor #EFF6FF
skinparam componentBorderColor #64748B
skinparam activityBackgroundColor #EFF6FF
skinparam activityBorderColor #64748B
skinparam activityDiamondBackgroundColor #FFF7ED
skinparam noteBackgroundColor #FFFBEA
skinparam noteBorderColor #D6C77A
skinparam classBackgroundColor #EFF6FF
skinparam classBorderColor #64748B
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #94A3B8

title プロトコルcrateと構成要素（設計案）

top to bottom direction
package "sim-can" as can {
  component "CanFrame" as canframe
  component "CanController" as cancontroller
  component "CanBus" as canbus
  component "CanArbitration" as canarbitration
  canframe -[hidden]down-> cancontroller
  cancontroller -[hidden]down-> canbus
  canbus -[hidden]down-> canarbitration
}
package "sim-ethernet" as ethernet {
  component "EthernetFrame" as ethframe
  component "EthernetLink" as ethlink
  component "EthernetSwitch" as ethswitch
  ethframe -[hidden]down-> ethlink
  ethlink -[hidden]down-> ethswitch
}
package "sim-soc" as soc {
  component "CpuCore" as cpu
  component "DmaEngine" as dma
  component "AxiInterconnect" as axi
  component "MemoryController" as memory
  component "MemoryRequest" as request
  component "MemoryResponse" as response
  cpu -[hidden]down-> dma
  dma -[hidden]down-> axi
  axi -[hidden]down-> memory
  memory -[hidden]down-> request
  request -[hidden]down-> response
}
can -[hidden]right-> ethernet
ethernet -[hidden]right-> soc
legend bottom
  構成要素の所属を示す。型の継承・通信経路・依存関係は示さない。
  sim-ethernetの対象：100BASE-T1 / 100BASE-TX。
  各crateはregister_modules()でRegistryへ登録する構成を検討中。
  再現範囲・必須動作はDIR-TBD-001で確定する。
endlegend
@enduml
